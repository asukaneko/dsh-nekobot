{
  "name": "dsh-nekobot",
  "version": "0.1.0",
  "description": "Nekobot character cards, worldbooks and roleplay for DeepSeek Harness",
  "license": "GPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=24.9.0"
  },
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "dist/*.js",
    "dist/*.js.map",
    "src",
    "scripts/build.mjs",
    "tsconfig.json",
    "pnpm-lock.yaml",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_LICENSES.txt"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts tests/*.test.tsx",
    "check": "pnpm typecheck && pnpm build && pnpm test && pnpm test:native",
    "test:native": "vitest run --config vitest.config.ts",
    "test:integration": "node --import tsx scripts/integration.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-api-session-controller": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-test-runtime": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.3",
    "@deepseek-ai/dsh-util-code-language": "0.2.1-rc.3",
    "@shikijs/langs": "^3.23.0",
    "@tanstack/react-virtual": "^3.14.22",
    "@testing-library/react": "^16.3.3",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "anser": "^2.3.5",
    "clsx": "^2.1.1",
    "diff": "^9.0.0",
    "esbuild": "^0.28.2",
    "fflate": "^0.8.2",
    "immer": "^11.2.9",
    "jsdom": "^30.1.3",
    "katex": "^0.19.1",
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-math": "^3.0.0",
    "micromark-core-commonmark": "^2.0.4",
    "micromark-extension-gfm": "^3.0.0",
    "micromark-extension-math": "^3.1.0",
    "micromark-factory-space": "^2.1.0",
    "micromark-util-character": "^2.1.1",
    "micromark-util-classify-character": "^2.0.1",
    "micromark-util-sanitize-uri": "^2.0.1",
    "micromark-util-symbol": "^2.0.1",
    "prettier": "^3.9.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "shiki": "^3.23.0",
    "simple-icons": "^16.36.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "use-sync-external-store": "^1.7.0",
    "vitest": "^4.1.12",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  }
}
